rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isSignedIn() && 
             (isEmailAdmin(request.auth.token.email) || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin')); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }


    function isEmailAdmin(email) {
      return email != null && (
        email.lower().endsWith('@fusaexplor.com') || 
        email.lower().endsWith('@fusaexplorer.com') ||
        email.lower() == 'riascosmarlon66@gmail.com' || 
        email.lower() == 'mike.otavo15@gmail.com' ||
        email.lower() == 'mike.otavo@fusaexplor.com'
      );
    }

    function isValidUsuario(data) {
      return data.nombre is string && data.nombre.size() > 0
          && data.correo is string && data.correo.size() > 0
          && data.rol in ['usuario', 'admin'];
    }

    function isValidCategoria(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 60
          && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
          && (data.keys().hasAll(['nombre', 'color']) && data.keys().size() >= 2);
    }

    function isValidLugar(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 150
          && data.direccion is string && data.direccion.size() > 0 && data.direccion.size() <= 300
          && data.categoriaId is string && isValidId(data.categoriaId)
          && data.puntuacion is number && data.puntuacion >= 0 && data.puntuacion <= 5
          && (data.lat is number || !('lat' in data))
          && (data.lng is number || !('lng' in data))
          && (data.imagenes is list || !('imagenes' in data))
          && (data.destacadoDuracion is string || !('destacadoDuracion' in data))
          && (data.destacadoHasta is string || !('destacadoHasta' in data))
          && (data.anuncioActivo is bool || !('anuncioActivo' in data))
          && (data.anuncioImagen is string || !('anuncioImagen' in data))
          && (data.anuncioDuracion is string || !('anuncioDuracion' in data))
          && (data.anuncioHasta is string || !('anuncioHasta' in data));
    }

    function isValidHistoria(data) {
      return data.usuarioId == request.auth.uid
          && data.usuarioNombre is string && data.usuarioNombre.size() > 0 && data.usuarioNombre.size() <= 100
          && data.expiresAt is string
          && (data.usuarioAvatar is string || !('usuarioAvatar' in data))
          && (data.imagen is string || !('imagen' in data))
          && (data.texto is string || !('texto' in data))
          && (data.background is string || !('background' in data));
    }

    function isValidComentario(data) {
      return data.usuarioId == request.auth.uid
          && data.puntuacion is number && data.puntuacion >= 0 && data.puntuacion <= 5
          && data.texto is string && data.texto.size() <= 300
          && (data.esPrivado is bool || !('esPrivado' in data));
    }

    function isValidReporte(data) {
      return data.tipo in ["trafico", "policia", "derrumbe", "semaforo", "desvio", "accidente"]
          && data.lat is number
          && data.lng is number
          && data.creadorId == request.auth.uid;
    }




    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && (
        (incoming().rol == 'usuario') || 
        (incoming().rol == 'admin' && (isEmailAdmin(incoming().correo) || isEmailAdmin(request.auth.token.email)))
      );
      allow update: if (isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'avatar', 'rol', 'createdAt']) && (
          !incoming().diff(existing()).affectedKeys().hasAny(['rol']) || 
          isEmailAdmin(incoming().get('correo', existing().get('correo', ''))) ||
          isAdmin() ||
          isEmailAdmin(request.auth.token.email)
        )
      )) || isAdmin();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isEmailAdmin(request.auth.token.email)) && isValidCategoria(incoming());
      allow delete: if (isAdmin() || isEmailAdmin(request.auth.token.email));
    }


    match /lugares/{lugarId} {
      allow read: if true;
      allow create: if (isAdmin() || isEmailAdmin(request.auth.token.email))
                     && isValidLugar(incoming())
                     && incoming().propietarioId == request.auth.uid;
      allow update: if (isAdmin() || isEmailAdmin(request.auth.token.email))
                     && isValidLugar(incoming());
      allow delete: if isAdmin() || isEmailAdmin(request.auth.token.email);
    }


    match /{path=**}/comentarios/{comentarioId} {
      allow read: if true;
    }
    match /lugares/{lugarId}/comentarios/{comentarioId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidComentario(incoming());
      allow update: if isSignedIn() && existing().usuarioId == request.auth.uid && isValidComentario(incoming());
      allow delete: if isSignedIn() && (existing().usuarioId == request.auth.uid || isAdmin());
    }

    match /historias/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidHistoria(incoming());
      allow update: if isSignedIn() && existing().usuarioId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().usuarioId == request.auth.uid || isAdmin());
    }
  }
}
